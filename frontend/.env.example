# Copier en .env et adapter selon l'environnement (local vs déployé).
# En local, remplace par l'IP de ta machine si tu testes depuis ton téléphone
# (ipconfig sous Windows) — jamais "localhost", inaccessible depuis un autre appareil.
VITE_API_BASE_URL=http://localhost:8000

# ID client OAuth Google (public). Facultatif : à défaut, celui du projet Yiri.
VITE_GOOGLE_CLIENT_ID=
