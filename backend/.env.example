# Copier ce fichier en .env et remplir les vraies valeurs. .env ne doit JAMAIS être commité.

# Génère une clé forte avec: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-moi-avec-une-vraie-cle-generee

# Par défaut SQLite en local. Sur Railway avec un service Postgres ajouté,
# utilise la variable DATABASE_URL que Railway fournit automatiquement
# (référence-la via ${{Postgres.DATABASE_URL}} dans les Variables du service
# backend). Le préfixe legacy "postgres://" est normalisé automatiquement
# en "postgresql://" par le code — pas besoin de le corriger à la main.
DATABASE_URL=sqlite:///./homme_complet.db

ACCESS_TOKEN_EXPIRE_MINUTES=60

# CSV des origines autorisées à appeler l'API (CORS). "*" par défaut pour le
# dev local. En prod, mets l'URL Vercel réelle, ex:
# ALLOWED_ORIGINS=https://homme-complet.vercel.app
ALLOWED_ORIGINS=*

# Notifications push web (rappels). Génère les tiennes avec :
#   python scripts/generate_vapid_keys.py
# VAPID_PUBLIC_KEY n'est pas un secret (envoyée au navigateur), mais
# VAPID_PRIVATE_KEY doit rester aussi confidentielle que SECRET_KEY.
# Sans ces deux variables, les rappels restent enregistrés en base mais
# aucune notification n'est réellement envoyée (dégradation silencieuse).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:ton-email@exemple.com
